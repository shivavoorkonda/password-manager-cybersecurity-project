<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="architecture-workflow-style" name="System Architecture"><mxGraphModel dx="1200" dy="620" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="System Architecture" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="500" height="40" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;1. Browser vault&lt;/b&gt;&lt;br&gt;AES-GCM encrypted entries&lt;br&gt;PBKDF2 key derivation" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="220" height="100" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;2. Local analysis&lt;/b&gt;&lt;br&gt;Flask on 127.0.0.1&lt;br&gt;Random Forest model" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#059669;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="365" y="150" width="190" height="100" as="geometry"/></mxCell><mxCell id="hibp" value="&lt;b&gt;3. HIBP range lookup&lt;/b&gt;&lt;br&gt;SHA-1 prefix only&lt;br&gt;No full password sent" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="635" y="150" width="220" height="100" as="geometry"/></mxCell><mxCell id="verdict" value="&lt;b&gt;4. Final security verdict&lt;/b&gt;&lt;br&gt;Consensus, breach status, recommendations&lt;br&gt;Rendered in the browser when needed" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="355" y="390" width="410" height="100" as="geometry"/></mxCell><mxCell id="privacy" value="&lt;b&gt;Privacy boundary&lt;/b&gt;&lt;br&gt;Complete password remains on the device." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="680" height="42" as="geometry"/></mxCell><mxCell id="e1" value="optional" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="browser" target="local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="SHA-1 prefix" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#ea580c;" edge="1" parent="1" source="local" target="hibp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="local" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hibp" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
