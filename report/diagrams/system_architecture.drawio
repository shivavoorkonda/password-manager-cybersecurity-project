<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="architecture" name="System Architecture"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Secure Password Manager — System Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="browser" value="Browser — React + TypeScript" style="swimlane;html=1;rounded=1;fillColor=#eff6ff;strokeColor=#2563eb;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="1100" height="250" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b&gt;Encrypted local vault&lt;/b&gt;&lt;br&gt;PBKDF2-HMAC-SHA256 (600,000)&lt;br&gt;AES-256-GCM&lt;br&gt;Encrypted localStorage entries" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#60a5fa;align=left;spacingLeft=12;" vertex="1" parent="browser"><mxGeometry x="30" y="60" width="290" height="140" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Password interface&lt;/b&gt;&lt;br&gt;Generator, search, categories&lt;br&gt;Rule meter + zxcvbn in browser&lt;br&gt;Optional loopback analysis" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#60a5fa;align=left;spacingLeft=12;" vertex="1" parent="browser"><mxGeometry x="405" y="60" width="290" height="140" as="geometry"/></mxCell><mxCell id="feedback" value="&lt;b&gt;Security feedback&lt;/b&gt;&lt;br&gt;ML confidence and consensus&lt;br&gt;HIBP breach status&lt;br&gt;Recommendations" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#60a5fa;align=left;spacingLeft=12;" vertex="1" parent="browser"><mxGeometry x="780" y="60" width="285" height="140" as="geometry"/></mxCell><mxCell id="flask" value="&lt;b&gt;Local Flask service — 127.0.0.1:5000&lt;/b&gt;&lt;br&gt;Optional password received over loopback&lt;br&gt;17 features → selected ML model&lt;br&gt;No password logging or persistence" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ecfdf5;strokeColor=#059669;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="150" y="420" width="430" height="145" as="geometry"/></mxCell><mxCell id="hibp" value="&lt;b&gt;HIBP Pwned Passwords API&lt;/b&gt;&lt;br&gt;Flask computes SHA-1 locally&lt;br&gt;Only five hash characters sent&lt;br&gt;Full password never reaches HIBP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff7ed;strokeColor=#ea580c;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="730" y="420" width="320" height="145" as="geometry"/></mxCell><mxCell id="node" value="Separate Node.js / PostgreSQL scaffold — not connected to current browser-vault flow" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f1f5f9;strokeColor=#64748b;dashed=1;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="620" width="760" height="40" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ui" target="flask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="SHA-1 prefix only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="flask" target="hibp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="flask" target="feedback"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
