<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="architecture-simple" name="System Architecture"><mxGraphModel dx="1200" dy="620" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Secure Password Manager - Simplified Architecture" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#173b3f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="20" width="780" height="40" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b&gt;1. Browser vault&lt;/b&gt;&lt;br&gt;Encrypted local credentials&lt;br&gt;AES-256-GCM + PBKDF2&lt;br&gt;Rule meter + zxcvbn&lt;br&gt;Generator and auto-lock&lt;br&gt;Password remains on the device" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eef6f4;strokeColor=#2f6f6d;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="320" height="310" as="geometry"/></mxCell><mxCell id="flask" value="&lt;b&gt;2. Local analysis&lt;/b&gt;&lt;br&gt;Flask at 127.0.0.1:5000&lt;br&gt;17 features -&gt; Random Forest&lt;br&gt;Consensus and suggestions&lt;br&gt;No password logging&lt;br&gt;Loopback only; not network exposed" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f1faf6;strokeColor=#1f7a68;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="320" height="310" as="geometry"/></mxCell><mxCell id="hibp" value="&lt;b&gt;3. HIBP check&lt;/b&gt;&lt;br&gt;SHA-1 calculated locally&lt;br&gt;Only first 5 hash characters sent&lt;br&gt;Suffixes matched locally&lt;br&gt;Full password never reaches HIBP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff6ed;strokeColor=#c96d32;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="320" height="310" as="geometry"/></mxCell><mxCell id="privacy" value="&lt;b&gt;PRIVACY BOUNDARY&lt;/b&gt;&lt;br&gt;The complete password remains on the user device." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e4efec;strokeColor=#b8ccc5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="520" width="780" height="60" as="geometry"/></mxCell><mxCell id="e1" value="optional analysis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vault" target="flask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="verdict + advice" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="flask" target="vault"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="SHA-1 prefix only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96d32;" edge="1" parent="1" source="flask" target="hibp"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
