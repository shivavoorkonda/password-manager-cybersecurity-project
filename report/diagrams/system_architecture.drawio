<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="architecture-workflow-style" name="System Architecture"><mxGraphModel dx="1200" dy="620" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="System Architecture" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="500" height="40" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;1. Browser vault&lt;/b&gt;&lt;br&gt;Encrypted AES-GCM entries&lt;br&gt;PBKDF2 key derivation&lt;br&gt;Analysis sends password to local Flask" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="140" width="260" height="125" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;2. Local Flask analysis&lt;/b&gt;&lt;br&gt;127.0.0.1:5000&lt;br&gt;17 features -&gt; active ML model&lt;br&gt;/analyze; separate /recommend call&lt;br&gt;Password handled in memory, not stored" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#059669;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="395" y="140" width="310" height="125" as="geometry"/></mxCell><mxCell id="hibp" value="&lt;b&gt;3. HIBP range lookup&lt;/b&gt;&lt;br&gt;Only five SHA-1 prefix chars sent&lt;br&gt;Returns suffix/count list&lt;br&gt;Flask checks full suffix locally" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea5800;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="775" y="140" width="315" height="125" as="geometry"/></mxCell><mxCell id="verdict" value="&lt;b&gt;4. Browser security feedback&lt;/b&gt;&lt;br&gt;ML verdict, confidence, breach status, consensus&lt;br&gt;Recommendations returned by separate endpoint when needed" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="315" y="390" width="560" height="100" as="geometry"/></mxCell><mxCell id="privacy" value="&lt;b&gt;Privacy boundary&lt;/b&gt;&lt;br&gt;Plaintext password stays on this computer during analysis; HIBP receives only the SHA-1 prefix." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#64748b;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="780" height="55" as="geometry"/></mxCell><mxCell id="e1" value="plaintext password over local loopback" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="browser" target="local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="five-character SHA-1 prefix" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#ea5800;" edge="1" parent="1" source="local" target="hibp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="local" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hibp" target="verdict"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
