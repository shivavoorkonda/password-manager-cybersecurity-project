<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="architecture-v2" name="System Architecture"><mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Secure Password Manager - Architecture and Trust Boundaries" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#173b3f;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="device" value="USER DEVICE - Browser application (React + TypeScript)" style="swimlane;html=1;rounded=1;fillColor=#eef6f4;strokeColor=#2f6f6d;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="50" y="95" width="900" height="635" as="geometry"/></mxCell><mxCell id="vault" value="&lt;b&gt;Encrypted vault&lt;/b&gt;&lt;br&gt;PBKDF2-HMAC-SHA256&lt;br&gt;600,000 iterations + salt&lt;br&gt;AES-256-GCM per record&lt;br&gt;Ciphertext in localStorage" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#4d8f90;align=left;spacingLeft=12;" vertex="1" parent="device"><mxGeometry x="40" y="80" width="250" height="180" as="geometry"/></mxCell><mxCell id="workspace" value="&lt;b&gt;Password workspace&lt;/b&gt;&lt;br&gt;Generator, search, categories&lt;br&gt;Rule meter + zxcvbn&lt;br&gt;Auto-lock after inactivity&lt;br&gt;Feedback stays in browser" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#4d8f90;align=left;spacingLeft=12;" vertex="1" parent="device"><mxGeometry x="342" y="80" width="250" height="180" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;Security result&lt;/b&gt;&lt;br&gt;Consensus verdict&lt;br&gt;Breach status&lt;br&gt;Recommendations&lt;br&gt;Shown when needed" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#4d8f90;align=left;spacingLeft=12;" vertex="1" parent="device"><mxGeometry x="644" y="80" width="220" height="180" as="geometry"/></mxCell><mxCell id="flask" value="&lt;b&gt;Local Flask analysis service&lt;/b&gt;&lt;br&gt;Loopback only: 127.0.0.1:5000&lt;br&gt;1. Extract 17 password features&lt;br&gt;2. Run selected Random Forest model&lt;br&gt;3. Return verdict and recommendations&lt;br&gt;Passwords are not logged or persisted" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1f7a68;align=left;spacingLeft=12;" vertex="1" parent="device"><mxGeometry x="95" y="365" width="560" height="190" as="geometry"/></mxCell><mxCell id="hibp" value="&lt;b&gt;EXTERNAL: HIBP Pwned Passwords API&lt;/b&gt;&lt;br&gt;SHA-1 computed locally&lt;br&gt;Only first 5 hash characters sent&lt;br&gt;Suffixes returned for local match&lt;br&gt;No full password sent outside" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff6ed;strokeColor=#c96d32;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1000" y="255" width="345" height="280" as="geometry"/></mxCell><mxCell id="privacy" value="&lt;b&gt;PRIVACY BOUNDARY&lt;/b&gt;&lt;br&gt;Full password never leaves device" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fffdf8;strokeColor=#c96d32;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="345" height="80" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vault" target="workspace"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="workspace" target="result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="optional local analysis" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="workspace" target="flask"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SHA-1 prefix only" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96d32;" edge="1" parent="1" source="flask" target="hibp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="verdict + breach result" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="flask" target="result"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
