<mxfile host="app.diagrams.net" modified="2026-10-24T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="workflow" name="Operational Workflow"><mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Secure Password Manager — Operational Workflow" style="text;html=1;fontSize=24;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="760" height="40" as="geometry"/></mxCell><mxCell id="s1" value="1. Unlock vault with master password" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="60" y="115" width="220" height="55" as="geometry"/></mxCell><mxCell id="s2" value="2. Derive key and decrypt local vault" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="350" y="115" width="220" height="55" as="geometry"/></mxCell><mxCell id="s3" value="3. Enter or generate password" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="640" y="115" width="220" height="55" as="geometry"/></mxCell><mxCell id="s4" value="4. Browser runs rule meter and zxcvbn" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="930" y="115" width="220" height="55" as="geometry"/></mxCell><mxCell id="s5" value="5. Optional full-password request over loopback" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="930" y="270" width="220" height="55" as="geometry"/></mxCell><mxCell id="s6" value="6. Flask extracts features and predicts strength" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="220" height="55" as="geometry"/></mxCell><mxCell id="s7" value="7. SHA-1; only five-character prefix sent to HIBP" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffedd5;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="350" y="270" width="220" height="55" as="geometry"/></mxCell><mxCell id="s8" value="8. Return breach status and consensus" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="220" height="55" as="geometry"/></mxCell><mxCell id="s9" value="9. Render result and recommendations when needed" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="350" y="430" width="220" height="55" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;html=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;html=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;html=1;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
